# development, production
NODE_ENV="production"

NGINX_OUT_PORT=8080

ALLOWED_ORIGINS=http://localhost:5173,https://my-app.example.com

JWT_SECRET=your-secret-key-at-least-256-bits-long

# Database url for Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipes?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipes_test?schema=public

# Postgres docker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recipes
POSTGRES_TEST_DB=recipes_test

# PgAdmin docker
PGADMIN_EMAIL=admin@local.org
PGADMIN_PASSWORD=rootroot
PGADMIN_PORT=8095

# https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
